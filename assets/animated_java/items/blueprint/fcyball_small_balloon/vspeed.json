{
	"model": {
		"type": "minecraft:select",
		"property": "minecraft:custom_model_data",
		"cases": [
			{
				"when": "AJ_INTERNAL_EMPTY",
				"model": {
					"type": "minecraft:model",
					"model": "animated_java:empty"
				}
			},
			{
				"when": "vspeed_up",
				"model": {
					"type": "minecraft:model",
					"model": "animated_java:blueprint/fcyball_small_balloon/vspeed_up/vspeed",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "vspeed_down",
				"model": {
					"type": "minecraft:model",
					"model": "animated_java:blueprint/fcyball_small_balloon/vspeed_down/vspeed",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "vspeed_stop",
				"model": {
					"type": "minecraft:model",
					"model": "animated_java:blueprint/fcyball_small_balloon/vspeed_stop/vspeed",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			}
		],
		"fallback": {
			"type": "minecraft:model",
			"model": "animated_java:blueprint/fcyball_small_balloon/vspeed",
			"tints": [
				{"type": "minecraft:dye", "default": [1, 1, 1]}
			]
		}
	}
}